rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여넣고 [게시] 하세요.
// TEACHER_EMAIL 자리에 선생님 계정 이메일을 넣어야 합니다.
//
// 요약
//   자료실 · 1인 1역               → 누구나 읽기, 선생님만 쓰기
//   전달사항                       → 누구나 읽기, 선생님만 쓰기
//   학급 일정                      → 누구나 읽기, 선생님만 쓰기. 쓸 때마다 기록(eventLogs)이 남음
//   일정 기록(eventLogs)           → 선생님만 읽기, 아무도 고치거나 지우지 못함
//   편집 권한(invites · editors)   → 쓰지 않음(2026-11 부터 학생 편집 권한 없음). 남은 것은 선생님이 지우기만
//   면담 예약(자리 참/빔)          → 누구나 읽기, 로그인한 기기가 신청, 취소는 신청한 기기와 선생님만
//   면담 신청 장부(bookers)        → 한 기기가 잡아 둘 수 있는 면담은 3건까지 (도배 막기)
//   신청자 이름 · 면담 내용        → 선생님만 읽기
//   학생 명단 · 누가기록           → 선생님만 읽고 쓰기 (가장 민감한 자료)

service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
          && request.auth.token.email in ['TEACHER_EMAIL'];
    }


    // ── 학생도 보는 것 ────────────────────────────────────────────
    // 전달사항: 선생님만 쓰고 지웁니다.
    match /notices/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /resources/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // ── 학급 일정: 선생님만 올리고 고치고 지웁니다 ────────────────
    // 쓸 때마다 eventLogs 에 기록이 한 장씩 같이 들어가야 하고(같은 배치), 기록은 고치거나 지울 수 없습니다.
    // 새로 올리는 일정의 ‘올린 사람(by)’은 ‘선생님’. 예전에 학생이 올린 일정은 고쳐도 by 가 그대로 남습니다.
    function evFieldsOk() {
      let d = request.resource.data;
      return d.keys().hasAll(['type', 'title', 'date', 'logId'])
          && d.keys().hasOnly(['type','title','date','subject','memo','by','photos','uid','logId','createdAt','updatedAt'])
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 5))
          && d.type in ['perf', 'exam', 'school', 'etc']
          && d.title is string
          && d.title.size() > 0
          && d.title.size() <= 60
          && d.date is string
          && d.date.size() == 10
          && (!('memo' in d) || (d.memo is string && d.memo.size() <= 500))
          && (!('subject' in d) || (d.subject is string && d.subject.size() <= 30))
          && (!('by' in d) || (d.by is string && d.by.size() <= 20));
    }
    // 이 쓰기와 같은 배치에 새 기록(eventLogs/{logId})이 들어가는지
    function evLogged(id, action) {
      let logId = request.resource.data.logId;
      let logPath = /databases/$(database)/documents/eventLogs/$(logId);
      return logId is string
          && logId.size() > 0 && logId.size() <= 40
          && !exists(logPath)
          && existsAfter(logPath)
          && getAfter(logPath).data.eventId == id
          && getAfter(logPath).data.action == action;
    }
    match /events/{id} {
      allow read: if true;
      allow create: if isTeacher()
        && evFieldsOk()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('by', '') == '선생님'
        && evLogged(id, 'create');
      allow update: if isTeacher()
        && evFieldsOk()
        && request.resource.data.get('uid', '') == resource.data.get('uid', '')
        && request.resource.data.get('by', '') == resource.data.get('by', '')
        && evLogged(id, 'update');
      // 지울 때는 기록 id 가 ‘일정id_del’ 로 정해져 있습니다.
      allow delete: if isTeacher()
        && !exists(/databases/$(database)/documents/eventLogs/$(id + '_del'))
        && existsAfter(/databases/$(database)/documents/eventLogs/$(id + '_del'));
    }

    // ── 일정 바뀐 기록: 선생님만 쓰고 읽고, 아무도 고치거나 지우지 못합니다 ──
    // 언제(서버 시각) · 어느 기기(uid)가 · 무엇을 썼는지.
    function logFieldsOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['eventId','action','uid','by','sidHint','client','type','title','date','subject','memo','photos','ua','at'])
          && d.keys().hasAll(['eventId','action','uid','title','date','at'])
          && d.uid == request.auth.uid
          && d.at == request.time
          && d.action in ['create', 'update', 'delete']
          && d.eventId is string && d.eventId.size() > 0 && d.eventId.size() <= 40
          && d.title is string && d.title.size() <= 60
          && d.date is string && d.date.size() <= 10
          && d.get('by', '') is string && d.get('by', '').size() <= 20
          && d.get('sidHint', '') is string && d.get('sidHint', '').size() <= 10
          && d.get('client', '') is string && d.get('client', '').size() <= 40
          && d.get('memo', '') is string && d.get('memo', '').size() <= 500
          && d.get('subject', '') is string && d.get('subject', '').size() <= 30
          && d.get('ua', '') is string && d.get('ua', '').size() <= 300
          && d.get('photos', 0) is int;
    }
    // 기록 내용이 실제로 쓰인 일정과 같아야 합니다(올리기·고치기는 쓴 뒤, 지우기는 지우기 전 내용).
    function logMatches(ev, logId, needLink) {
      let d = request.resource.data;
      return (!needLink || ev.get('logId', '') == logId)
          && ev.title == d.title
          && ev.date == d.date
          && ev.type == d.get('type', '')
          && ev.get('memo', '') == d.get('memo', '')
          && ev.get('subject', '') == d.get('subject', '')
          && ev.get('by', '') == d.get('by', '');
    }
    match /eventLogs/{logId} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && logFieldsOk()
        && (request.resource.data.action == 'delete'
              ? (logId == request.resource.data.eventId + '_del'
                 && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
                 && !existsAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId))
                 && logMatches(get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data, logId, false))
              : (existsAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId))
                 && logMatches(getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data, logId, true)));
      allow update, delete: if false;
    }

    // ── 편집 권한 ─────────────────────────────────────────────────
    // config/perm: 일정 올리기 범위. 누구나 읽고 선생님만 바꿉니다.
    match /config/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // invites/{코드}: 예전 편집 권한 코드. 이제 쓰지 않으니 선생님만 보고 지웁니다.
    match /invites/{code} {
      allow read, write: if isTeacher();
    }
    // editors/{기기 uid}: 예전에 코드를 넣은 학생 기기. 이제 아무 권한도 주지 않고, 새로 만들 수도 없습니다.
    // 남아 있는 것은 선생님 화면에서 한 번에 지울 수 있습니다.
    match /editors/{uid} {
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if false;
      allow delete: if isTeacher() || (request.auth != null && request.auth.uid == uid);
    }

    // ── 1인 1역: 누구나 읽기, 선생님만 쓰기 ──────────────────────
    // 학번만 담고 이름은 담지 않습니다.
    match /roles/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── 면담 예약: 자리가 찼는지 여부만 공개 ──────────────────────
    // create 는 문서가 없을 때만 성공하므로 중복 예약이 서버에서 막힙니다.
    // 선생님이 닫은 시간대(closures/{날짜_시간대})에는 예약이 만들어지지 않습니다.
    // 신청한 기기(uid)가 같이 저장되고, 취소는 그 기기와 선생님만 할 수 있습니다.
    // (uid 가 없는 예전 예약은 선생님만 취소합니다.)
    // 학생은 오늘부터 3주 안의 날짜만 잡습니다(1년 치를 한꺼번에 채우는 장난 막기). 선생님은 날짜 제한 없음.
    // 한 기기가 잡아 둘 수 있는 면담은 3건까지입니다. 신청할 때 같은 배치로 자기 장부(bookers/{uid})에
    // 그 예약 id 를 적어야 하고, 장부에는 3건까지만 적힙니다(아래 bookers 규칙).
    function bookingDateOk(d) {
      let day = timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
      return day > request.time - duration.value(1, 'd')
          && day < request.time + duration.value(22, 'd');
    }
    match /bookings/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['date', 'slot', 'client', 'uid', 'createdAt'])
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
                    && request.resource.data.client is string
                    && request.resource.data.client.size() <= 24
                    && request.resource.data.createdAt is int
                    && (isTeacher()
                        || (bookingDateOk(request.resource.data.date)
                            && id in getAfter(/databases/$(database)/documents/bookers/$(request.auth.uid)).data.ids))
                    && request.resource.data.slot in ['am', 'lunch', 'pm', 'pm2']
                    && id == request.resource.data.date + '_' + request.resource.data.slot
                    && request.resource.data.uid is string
                    && (request.resource.data.uid == request.auth.uid || isTeacher())   // 선생님은 옮길 때 원래 신청 기기로 남김
                    && !exists(/databases/$(database)/documents/closures/$(id));
      allow delete: if isTeacher()
                    || (request.auth != null && resource.data.get('uid', '') == request.auth.uid);
      allow update: if isTeacher();
    }
    function bookingOwnedByMe(id) {
      return exists(/databases/$(database)/documents/bookings/$(id))
          && get(/databases/$(database)/documents/bookings/$(id)).data.get('uid', '') == request.auth.uid;
    }

    // ── 면담 신청 장부: 기기(uid)마다 한 장, 지금 잡아 둔 예약 id 를 3건까지 ──
    // 장부에 적힌 예약은 모두 ‘이 기기가 잡은, 실제로 있는 예약’이어야 합니다.
    // 장부에서 지울 수 있는 것은 취소됐거나, 남이 다시 잡았거나, 날짜가 지난 예약뿐입니다.
    // 그래서 예약을 그대로 둔 채 장부만 비워서 더 잡을 수는 없습니다.
    function bookingDoc(bid) {
      return /databases/$(database)/documents/bookings/$(bid);
    }
    function bookingPast(bid) {
      return timestamp.date(int(bid[0:4]), int(bid[5:7]), int(bid[8:10])) < request.time - duration.value(1, 'd');
    }
    function listedMine(ids, i, uid) {
      return ids.size() <= i
          || (ids[i] is string
              && existsAfter(bookingDoc(ids[i]))
              && getAfter(bookingDoc(ids[i])).data.get('uid', '') == uid);
    }
    function mayDrop(old, i, now, uid) {
      return old.size() <= i
          || old[i] in now
          || !existsAfter(bookingDoc(old[i]))
          || getAfter(bookingDoc(old[i])).data.get('uid', '') != uid
          || bookingPast(old[i]);
    }
    function bookerOk(uid) {
      let ids = request.resource.data.ids;
      return request.resource.data.keys().hasOnly(['ids', 'updatedAt'])
          && ids is list
          && ids.size() <= 3
          && listedMine(ids, 0, uid) && listedMine(ids, 1, uid) && listedMine(ids, 2, uid);
    }
    match /bookers/{uid} {
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid && bookerOk(uid);
      allow update: if request.auth != null && request.auth.uid == uid && bookerOk(uid)
                    && mayDrop(resource.data.ids, 0, request.resource.data.ids, uid)
                    && mayDrop(resource.data.ids, 1, request.resource.data.ids, uid)
                    && mayDrop(resource.data.ids, 2, request.resource.data.ids, uid);
      allow delete: if isTeacher();
    }

    // ── 면담 시간대 닫기: 누구나 읽기(‘닫힘’ 표시), 선생님만 닫고 열기 ──
    match /closures/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── 신청자 이름 · 면담 내용: 선생님만 읽습니다 ────────────────
    match /bookingDetails/{id} {
      allow read: if isTeacher();
      // 그 자리를 잡은 기기(또는 선생님)만 사유를 적습니다.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['name', 'klass', 'reason', 'client', 'uid', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 20
                    && request.resource.data.klass is string
                    && request.resource.data.klass.size() <= 10
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500
                    && exists(/databases/$(database)/documents/bookings/$(id))
                    && request.resource.data.uid == get(/databases/$(database)/documents/bookings/$(id)).data.get('uid', '')
                    && (isTeacher() || bookingOwnedByMe(id));
      // 지우기: 선생님, 신청한 기기, 또는 예약이 이미 없어진 찌꺼기를 지금 그 자리를 잡은 기기가 치울 때
      allow delete: if isTeacher()
                    || (request.auth != null
                        && (resource.data.get('uid', '') == request.auth.uid
                            || !exists(/databases/$(database)/documents/bookings/$(id))
                            || bookingOwnedByMe(id)));
      allow update: if isTeacher();
    }

    // ── 학생 명단: 선생님만 ───────────────────────────────────────
    // 학생 이름은 공개 저장소에 넣지 않고 여기에만 둡니다.
    match /students/{sid} {
      allow read, write: if isTeacher();
    }

    // ── 상담 · 행동특성 누가기록: 선생님만 ────────────────────────
    // 학생 본인도 읽을 수 없습니다.
    match /records/{sid} {
      allow read, write: if isTeacher();
      match /{document=**} {
        allow read, write: if isTeacher();
      }
    }

    // ── 교과 성적: 선생님만 ───────────────────────────────────────
    // 원점수 · 성취도 · 석차등급이 들어 있습니다. 학생 본인도 읽을 수 없습니다.
    match /grades/{sid} {
      allow read, write: if isTeacher();
    }

    // ── 모의고사(전국연합학력평가) 성적: 선생님만 ─────────────────
    // 원점수 · 표준점수 · 백분위 · 등급 · 석차. 학생 본인도 읽을 수 없습니다.
    match /mocks/{id} {
      allow read, write: if isTeacher();
    }

    // ── 선생님 할 일 메모: 선생님만 ───────────────────────────────
    match /todos/{id} {
      allow read, write: if isTeacher();
    }

    // ── 대학별 환산표: 선생님만 ───────────────────────────────────
    match /unis/{id} {
      allow read, write: if isTeacher();
    }


    // ══════════════════════════════════════════════════════════════
    // 진로방송부 스튜디오 (같은 Firebase 프로젝트를 쓰는 다른 사이트)
    //   https://github.com/JunRepos/bangsong
    //   반 사이트 자료와 완전히 따로, bc… 로 시작하는 곳만 씁니다.
    //   부원은 학번 + 비밀번호로 로그인합니다(계정 이메일 bc학번@example.com).
    //   처음 가입할 때 방송부 코드가 맞아야 부원이 됩니다.
    // ══════════════════════════════════════════════════════════════
    function isBcMember() {
      return request.auth != null
          && exists(/databases/$(database)/documents/bcMembers/$(request.auth.uid));
    }
    function bcJoinCode() {
      return get(/databases/$(database)/documents/bcJoin/code).data.code;
    }

    // 방송국 이름·소개: 누구나 읽기, 선생님만 쓰기
    match /bcInfo/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // 참여 코드: 선생님만 봅니다. 입장할 때는 규칙 안에서만 맞춰 봅니다.
    match /bcJoin/{id} {
      allow read, write: if isTeacher();
    }
    // 부원 가입: 학번 계정으로 로그인한 본인이, 방송부 코드로 한 장 만듭니다.
    function bcJoinOk(uid) {
      return request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['sid', 'code', 'name', 'joinedAt'])
          && request.resource.data.sid is string
          && request.resource.data.sid.matches('^[0-9]{3,8}$')
          && request.auth.token.email == 'bc' + request.resource.data.sid + '@example.com'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.code == bcJoinCode();
    }
    match /bcMembers/{uid} {
      allow get: if isTeacher() || isBcMember() || (request.auth != null && request.auth.uid == uid);
      allow list: if isTeacher() || isBcMember();
      allow create: if bcJoinOk(uid);
      allow update: if isTeacher() || bcJoinOk(uid);
      allow delete: if isTeacher() || (request.auth != null && request.auth.uid == uid);
    }
    // 작품(방송·신문·영상·행사): 누구나 읽기(편성표).
    //   부원은 ‘기획안(pitch)’만 만들고 자기 기획안만 고칩니다.
    //   크레딧(crew)에 든 부원은 제작 단계와 링크만 바꿀 수 있습니다.
    match /bcProds/{id} {
      allow read: if true;
      allow create: if isTeacher()
                    || (isBcMember()
                        && request.resource.data.status == 'pitch'
                        && request.resource.data.byUid == request.auth.uid);
      allow update: if isTeacher()
                    || (isBcMember()
                        && resource.data.status == 'pitch' && resource.data.byUid == request.auth.uid
                        && request.resource.data.status == 'pitch'
                        && request.resource.data.byUid == request.auth.uid)
                    || (isBcMember()
                        && resource.data.status == 'go'
                        && request.auth.uid in resource.data.crew
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'links', 'updatedAt']));
      allow delete: if isTeacher()
                    || (isBcMember() && resource.data.status == 'pitch'
                        && resource.data.byUid == request.auth.uid);
    }
    // 점심방송 담당(월~금): 누구나 읽기, 선생님만 쓰기
    match /bcDuty/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // 일정(리허설·장비 점검·회의 등): 누구나 읽기(캘린더), 선생님만 쓰기
    match /bcEvents/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // 원고·대본 · 피드백: 부원끼리 보고, 자기 것만 고치고 지웁니다.
    match /bcItems/{id} {
      allow read: if isTeacher() || isBcMember();
      allow create: if isTeacher()
                    || (isBcMember() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher()
                            || (isBcMember() && resource.data.uid == request.auth.uid);
    }
    match /bcComments/{id} {
      allow read: if isTeacher() || isBcMember();
      allow create: if isTeacher()
                    || (isBcMember() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher()
                            || (isBcMember() && resource.data.uid == request.auth.uid);
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
