rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여넣고 [게시] 하세요.
// TEACHER_EMAIL 자리에 선생님 계정 이메일을 넣어야 합니다.
//
// 요약
//   자료실 · 1인 1역               → 누구나 읽기, 선생님만 쓰기
//   전달사항                       → 누구나 읽기, 선생님과 ‘전달사항 쓰기’ 권한 학생이 쓰기
//   학급 일정                      → 누구나 읽기, 쓰기는 설정에 따라(모든 학생 / 권한 받은 학생만),
//                                    지우기는 선생님과 ‘일정 관리’ 권한 학생
//   편집 권한(invites · editors)   → 선생님이 코드를 만들고, 학생 기기가 코드를 넣어 권한을 받음
//   면담 예약(자리 참/빔)          → 누구나 읽기, 누구나 신청, 중복은 서버가 거부
//   신청자 이름 · 면담 내용        → 선생님만 읽기
//   학생 명단 · 누가기록           → 선생님만 읽고 쓰기 (가장 민감한 자료)

service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
          && request.auth.token.email in ['TEACHER_EMAIL'];
    }

    // 선생님이 준 코드를 넣은 학생 기기(익명 로그인)가 그 권한을 가졌는지
    function isEditor(scope) {
      return request.auth != null
          && exists(/databases/$(database)/documents/editors/$(request.auth.uid))
          && scope in get(/databases/$(database)/documents/editors/$(request.auth.uid)).data.scopes;
    }
    // 선생님이 ‘권한 받은 학생만’으로 바꾸기 전까지는 누구나 일정을 올립니다.
    function eventsOpen() {
      return !exists(/databases/$(database)/documents/config/perm)
          || get(/databases/$(database)/documents/config/perm).data.eventsOpen != false;
    }

    // ── 학생도 보는 것 ────────────────────────────────────────────
    // 전달사항: 선생님과 ‘전달사항 쓰기’ 권한 학생. 지우기는 선생님만.
    match /notices/{id} {
      allow read: if true;
      allow create, update: if isTeacher() || isEditor('notices');
      allow delete: if isTeacher();
    }
    match /resources/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // ── 학급 일정: 학생도 올리고 고칠 수 있습니다 ─────────────────
    // 선생님이 ‘권한 받은 학생만’으로 바꾸면 선생님과 ‘일정 관리’ 권한 학생만.
    // 지우는 것은 선생님과 ‘일정 관리’ 권한 학생만. 시험 일정이 말없이 사라지는 일을 막기 위해서입니다.
    match /events/{id} {
      allow read: if true;
      allow create, update:
        if (isTeacher() || isEditor('events') || eventsOpen())
        && request.resource.data.keys().hasAll(['type', 'title', 'date'])
        && request.resource.data.keys().hasOnly(['type','title','date','subject','memo','by','photos','createdAt','updatedAt'])
        && (!('photos' in request.resource.data) || request.resource.data.photos.size() <= 5)
        && request.resource.data.type in ['perf', 'exam', 'school', 'etc']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && (!('memo' in request.resource.data) || request.resource.data.memo.size() <= 500)
        && (!('subject' in request.resource.data) || request.resource.data.subject.size() <= 30)
        && (!('by' in request.resource.data) || request.resource.data.by.size() <= 20);
      allow delete: if isTeacher() || isEditor('events');
    }

    // ── 편집 권한 ─────────────────────────────────────────────────
    // config/perm: 일정 올리기 범위. 누구나 읽고 선생님만 바꿉니다.
    match /config/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // invites/{코드}: 선생님이 만든 권한 코드. 코드를 아는 사람만 그 한 장을 읽을 수 있고, 목록은 선생님만.
    match /invites/{code} {
      allow get: if true;
      allow list, write: if isTeacher();
    }
    // editors/{기기 uid}: 코드를 넣은 학생 기기. 코드와 권한이 선생님이 만든 것과 똑같아야 만들어집니다.
    match /editors/{uid} {
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['code', 'sid', 'scopes', 'createdAt'])
                    && request.resource.data.code is string
                    && request.resource.data.code.size() == 6
                    && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.sid == request.resource.data.sid
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.scopes == request.resource.data.scopes;
      allow update: if isTeacher();
      allow delete: if isTeacher() || (request.auth != null && request.auth.uid == uid);
    }

    // ── 1인 1역: 누구나 읽기, 선생님만 쓰기 ──────────────────────
    // 학번만 담고 이름은 담지 않습니다.
    match /roles/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── 면담 예약: 자리가 찼는지 여부만 공개 ──────────────────────
    // create 는 문서가 없을 때만 성공하므로 중복 예약이 서버에서 막힙니다.
    match /bookings/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'slot', 'client', 'createdAt'])
                    && request.resource.data.date is string
                    && request.resource.data.slot in ['am', 'lunch', 'pm'];
      allow delete: if true;          // 학생 본인 취소용 (README 주의사항 참고)
      allow update: if isTeacher();
    }

    // ── 신청자 이름 · 면담 내용: 선생님만 읽습니다 ────────────────
    match /bookingDetails/{id} {
      allow read: if isTeacher();
      allow create: if request.resource.data.keys().hasOnly(['name', 'klass', 'reason', 'client', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 20
                    && request.resource.data.reason.size() <= 500;
      allow delete: if true;
      allow update: if isTeacher();
    }

    // ── 학생 명단: 선생님만 ───────────────────────────────────────
    // 학생 이름은 공개 저장소에 넣지 않고 여기에만 둡니다.
    match /students/{sid} {
      allow read, write: if isTeacher();
    }

    // ── 상담 · 행동특성 누가기록: 선생님만 ────────────────────────
    // 학생 본인도 읽을 수 없습니다.
    match /records/{sid} {
      allow read, write: if isTeacher();
      match /{document=**} {
        allow read, write: if isTeacher();
      }
    }

    // ── 교과 성적: 선생님만 ───────────────────────────────────────
    // 원점수 · 성취도 · 석차등급이 들어 있습니다. 학생 본인도 읽을 수 없습니다.
    match /grades/{sid} {
      allow read, write: if isTeacher();
    }

    // ── 모의고사(전국연합학력평가) 성적: 선생님만 ─────────────────
    // 원점수 · 표준점수 · 백분위 · 등급 · 석차. 학생 본인도 읽을 수 없습니다.
    match /mocks/{id} {
      allow read, write: if isTeacher();
    }

    // ── 대학별 환산표: 선생님만 ───────────────────────────────────
    match /unis/{id} {
      allow read, write: if isTeacher();
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
