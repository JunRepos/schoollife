rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여넣고 [게시] 하세요.
// TEACHER_EMAIL 자리에 선생님 계정 이메일을 넣어야 합니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
          && request.auth.token.email in ['TEACHER_EMAIL'];
    }

    // ── 전달사항 · 학급 일정 · 시간표 ────────────────────────────
    // 누구나 읽고, 선생님만 씁니다.
    match /notices/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /events/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /timetable/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── 면담 예약: 자리가 찼는지 여부만 공개 ──────────────────────
    // create 는 문서가 없을 때만 성공하므로 중복 예약이 서버에서 막힙니다.
    match /bookings/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'slot', 'client', 'createdAt'])
                    && request.resource.data.date is string
                    && request.resource.data.slot in ['am', 'lunch', 'pm'];
      allow delete: if true;          // 학생 본인 취소용 (아래 README 주의사항 참고)
      allow update: if isTeacher();
    }

    // ── 신청자 이름 · 면담 내용: 선생님만 읽습니다 ────────────────
    match /bookingDetails/{id} {
      allow read: if isTeacher();
      allow create: if request.resource.data.keys().hasOnly(['name', 'klass', 'reason', 'client', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 20
                    && request.resource.data.reason.size() <= 500;
      allow delete: if true;
      allow update: if isTeacher();
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
