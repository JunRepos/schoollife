rules_version = '2';

// Firebase 콘솔 > Storage > Rules 에 그대로 붙여넣고 [게시] 하세요.
// TEACHER_EMAIL 자리에 선생님 계정 이메일을 넣어야 합니다.
// (Firestore 규칙과 파일이 다릅니다. 둘 다 게시해야 합니다.)

service firebase.storage {
  match /b/{bucket}/o {

    function isTeacher() {
      return request.auth != null
          && request.auth.token.email in ['TEACHER_EMAIL'];
    }

    // 자료실 파일 — 학생은 열어 보기만, 올리고 지우는 것은 선생님만
    match /resources/{docId}/{fileName} {
      allow read: if true;
      allow write: if isTeacher() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isTeacher();
    }

    // 학급 일정에 붙는 사진 — 일정과 같은 규칙으로 학생도 올릴 수 있습니다.
    // 사진 파일만, 한 장 8MB 까지. 덮어쓰기와 삭제는 선생님만.
    match /events/{docId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if isTeacher();
    }

    // 그 밖의 모든 경로는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
